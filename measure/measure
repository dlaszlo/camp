#!/bin/bash
#
# One command for the whole terminal-gated group.
#
# It exists because the measurements need a person at a terminal -- sudo
# asks for a password there and cannot ask anywhere else -- while nothing
# in them needs a person to type each step. So the person types this, once,
# and everything lands in one file that somebody else can read afterwards.
#
#   ./measure                 build, one ordinary run, then both drivers
#   ./measure build           build the two binaries and stop
#   ./measure run             one ordinary camp up and camp down
#   ./measure killmatrix      the kill matrix alone
#   ./measure renamerace      the rename race alone
#
# It stops at the first stage that fails. A stage measuring rubble left by
# the one before it measures nothing.
#
# Run it as yourself, from a terminal. camp's front end refuses to run as
# root on purpose, and this drives the front end.

set -u -o pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=${CAMP_REPO:-$here/../../camp}
env=${CAMP_ENV:-$HOME/campcheck}
log=${CAMP_LOG:-$here/measure.log}

plain=$env/camp
barriers=$env/camp-barriers

if [ "$(id -u)" = 0 ]; then
    echo "Run this as yourself, not with sudo: camp's front end refuses to" \
         "run as root and this drives the front end." >&2
    exit 2
fi

say() { printf '\n=== %s ===\n\n' "$*"; }

stage_build() {
    say "building"
    ( cd "$repo" && go build -o "$plain" ./cmd/camp ) || return 1
    ( cd "$repo" && go build -tags camptest -o "$barriers" ./cmd/camp ) || return 1
    echo "  $plain"
    echo "  $barriers"
}

# One ordinary run. It is what proves the mount and unmount paths work at
# all, and it is much cheaper to read a failure here than the same failure
# from inside a driver's census.
stage_run() {
    say "one ordinary camp up and camp down"
    if [ ! -f "$env/.camp/config.yml" ] && [ -f "$env/.camp/config.yml.away" ]; then
        mv "$env/.camp/config.yml.away" "$env/.camp/config.yml"
    fi
    ( cd "$env" && "$plain" up ) || return 1
    ( cd "$env" && "$plain" down ) || return 1

    # Nothing of camp's may be left standing anywhere, including the
    # directory the helper takes a mount to before it unmounts it.
    local left
    left=$(awk -v e="$env" '$5 == e || index($5, e "/") == 1 ||
                            $5 == "/run/camp" || index($5, "/run/camp/") == 1 {print $1, $5}' \
           /proc/self/mountinfo)
    if [ -n "$left" ]; then
        echo "still mounted after an ordinary teardown:" >&2
        echo "$left" >&2
        return 1
    fi
    echo "  clean: nothing of camp's is mounted"
}

stage_killmatrix() {
    say "the kill matrix"
    ( cd "$here" && go run ./killmatrix -env "$env" -camp "$barriers" )
}

stage_renamerace() {
    say "the rename race"
    ( cd "$here" && go run ./renamerace -env "$env" -camp "$barriers" )
}

main() {
    local stages=("$@")
    if [ ${#stages[@]} -eq 0 ]; then
        stages=(build run killmatrix renamerace)
    fi

    printf 'environment: %s\nrepository:  %s\nstarted:     %s\n' \
        "$env" "$repo" "$(date -Is)"

    # The password once, so that no stage meets a prompt in the middle of a
    # measurement -- and only when there is one to give. A machine that
    # exists for one run has no password and no terminal to type it on, and
    # asking there would fail on a machine where nothing needed asking.
    sudo -n true 2>/dev/null || sudo -v || return 2

    for stage in "${stages[@]}"; do
        if ! "stage_$stage"; then
            say "$stage failed -- stopping here"
            return 1
        fi
    done
    say "every stage finished"
}

main "$@" 2>&1 | tee "$log"
status=${PIPESTATUS[0]}
printf '\nall of it is in %s\n' "$log"
exit "$status"
