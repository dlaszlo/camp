#!/bin/bash
# The environment's own commands, in the mode that elevates.
#
# The local suite reaches everything about `prepare:` except the half that
# only exists here: `camp up` is the mode that runs a root helper, and the
# promise is that configured code never meets that privilege -- it runs in
# the unprivileged front end, as the invoking user, before anything is
# elevated. That is a claim about a machine with root on it, so it is
# measured on one.
#
# It builds an environment of its own rather than editing the one the
# stages around it share: a configuration key added here and left behind
# would quietly change what every later stage measures.
set -eu
src=${CAMP_SRC:-$HOME/camp}
env=${CAMP_PREPARE_ENV:-$HOME/campprepare}

rm -rf "$env"
mkdir -p "$env"/{workspace,code,live,bin}

git -C "$env/workspace" init -q -b main
printf 'the workspace, read-only inside the composition\n' > "$env/workspace/notes"
printf '/live/\n' > "$env/workspace/.gitignore"
git -C "$env/workspace" add -A
git -C "$env/workspace" -c user.email=camp@vm -c user.name=camp commit -qm "the workspace"

git -C "$env/code" init -q -b main
printf '# the code repository, where writes land\n' > "$env/code/README.md"
printf '/live/\n' > "$env/code/.gitignore"
git -C "$env/code" add -A
git -C "$env/code" -c user.email=camp@vm -c user.name=camp commit -qm "the code"

# It records who ran it and where, which is the whole question, and it
# answers whether it succeeded from a file the stage writes: the same
# command is run twice, once as a guard that passes and once as one that
# refuses.
cat > "$env/bin/guard" <<'GUARD'
#!/bin/bash
printf '%s %s %s\n' "$(id -u)" "$PWD" "$CAMP_ENV" > "$CAMP_ENV/what-the-guard-saw"
exit "$(cat "$CAMP_ENV/what-the-guard-answers")"
GUARD
chmod +x "$env/bin/guard"

mkdir -p "$env/.camp"
cat > "$env/.camp/config.yml" <<YAML
env: $env
merged: live

repositories:
  - { name: workspace, path: workspace }
  - { name: code,      path: code }

overlayfs:
  lower: [workspace]
  upper: code

allow_overlap: [.gitignore]

prepare:
  - command: ["$env/bin/guard"]
    timeout: 60

steps:
  - mount_rw:
      - { source: "code/.git", target: ".git" }
  - git_exclude
YAML

cd "$env"
camp accept

# -- the guard passes, and camp up composes
echo 0 > "$env/what-the-guard-answers"
camp up
camp down

saw=$(cat "$env/what-the-guard-saw")
if [ "$saw" != "$(id -u) $env $env" ]; then
    echo "the prepare command saw: $saw" >&2
    echo "and it had to run as uid $(id -u), standing in $env, told CAMP_ENV=$env" >&2
    exit 1
fi
echo "   the guard ran as uid $(id -u) -- never as root -- in $env"

# -- the guard refuses, and nothing is mounted
echo 3 > "$env/what-the-guard-answers"
rm -f "$env/what-the-guard-saw"
if camp up > "$env/refusal" 2>&1; then
    echo "camp up composed the tree although the prepare command failed:" >&2
    cat "$env/refusal" >&2
    exit 1
fi
if ! grep -q 'prepare command 1' "$env/refusal"; then
    echo "the refusal does not name the command that failed:" >&2
    cat "$env/refusal" >&2
    exit 1
fi
if [ ! -f "$env/what-the-guard-saw" ]; then
    echo "the prepare command never ran at all, so this measured nothing" >&2
    exit 1
fi

left=$(awk -v e="$env" '$5 == e || index($5, e "/") == 1 {print $1, $5}' /proc/self/mountinfo)
if [ -n "$left" ]; then
    echo "a refused prepare command left mounts behind:" >&2
    echo "$left" >&2
    exit 1
fi
echo "   a prepare command that refuses stops camp up with nothing mounted"
