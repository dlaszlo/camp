# Build output
/camp
/dist/

# Go
*.test
*.out

# An environment's own directory, in case somebody composes from inside a
# checkout. camp writes the matching rules into .camp/.gitignore itself,
# which is where they belong: the environment root may belong to a
# repository, to a different one tomorrow, or to none at all.
.camp/work/
.camp/storage/
.camp/reports/
camp_*.deb

# What the measurements leave behind: the machine's log.
measure/vm/vm.log
